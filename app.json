{
  "expo": {
    "name": "Agenda de Empresas",
    "slug": "agenda-empresas",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "agendaempresas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tecsattv.agendaempresas",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Gravar as coordenadas da empresa"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.tecsattv.agendaempresas",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gravar as coordenadas da empresa"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
